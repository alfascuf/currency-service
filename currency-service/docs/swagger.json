                "base": {
                    "type": "string"
                },
                "date": {
                    "type": "string"
                },
                "error": {
                    "type": "string"
                },
                "rate": {
                    "type": "number"
                },
                "target": {
                    "type": "string"
                }
            }
        }
    }
