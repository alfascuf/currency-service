                },
                "id": {
                    "type": "integer"
                },
                "rate": {
                    "type": "number"
                },
                "target": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "github_com_alfascuf_PROD1_currency-service_internal_models.GetHistoryResponse": {
            "type": "object",
            "properties": {
                "base": {
                    "type": "string"
                },
                "data": {
                    "type": "array",
