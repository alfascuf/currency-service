    ],
    "swagger": "2.0",
    "info": {
        "description": "API для получения курсов валют с поддержкой gRPC и HTTP",
        "title": "Currency Exchange API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
