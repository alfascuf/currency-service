# Common Settings

ENVIRONMENT=development

# PostgreSQL Database

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=currency_db

# Currency Service

CURRENCY_PORT=8082
EXCHANGE_API_KEY=your_api_key_here
BASE_CURRENCY=RUB
DATABASE_URL=postgres://postgres:your_password@postgres:5432/currency_db?sslmode=disable
DATABASE_DRIVER=postgres
CURRENCY_API_URL=https://api.exchangerate-api.com/v4

# Gateway Service

GATEWAY_PORT=8080
CURRENCY_API_URL=http://currency-api:8082
AUTH_API_URL=http://auth-service:8081
JWT_SECRET=change-this-secret-in-production
